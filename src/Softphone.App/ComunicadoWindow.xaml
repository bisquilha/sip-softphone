<Window x:Class="Softphone.App.ComunicadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comunicado da TI - Softphone" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="True"
        FontFamily="Segoe UI" FontSize="13" Icon="Assets/softphone.ico" UseLayoutRounding="True" WindowStartupLocation="Manual">
    <Border x:Name="Moldura" Background="{DynamicResource BgWindow}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="10" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <Border x:Name="Faixa" Background="{DynamicResource Accent}" CornerRadius="8,8,0,0" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtIcone" FontFamily="{StaticResource Icones}" Text="&#xE789;" Foreground="{DynamicResource OnAccent}" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtNivel" Grid.Column="1" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <StackPanel Margin="16,12,16,14">
                <TextBlock x:Name="TxtTitulo" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                <TextBox x:Name="TxtTexto" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,8,0,0"
                         FontSize="13.5" Foreground="{DynamicResource TextPrimary}" MaxHeight="260" VerticalScrollBarVisibility="Auto" />
                <TextBlock x:Name="TxtRodape" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                <Button x:Name="BtnCiente" Style="{StaticResource BtnPrimario}" Content="Ciente" HorizontalAlignment="Right" Padding="22,7" Margin="0,12,0,0" Click="Ciente_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
