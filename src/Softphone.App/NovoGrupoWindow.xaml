<Window x:Class="Softphone.App.NovoGrupoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo grupo" Width="400" Height="560" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18,8,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Rotulo}" Text="Nome do grupo" />
        <TextBox x:Name="CaixaNome" Grid.Row="1" AutomationProperties.Name="Nome do grupo" />
        <TextBlock Grid.Row="2" Style="{StaticResource Rotulo}" x:Name="TxtSelecionados" Text="Participantes" />
        <TextBox x:Name="CaixaBusca" Grid.Row="3" TextChanged="Busca_TextChanged" AutomationProperties.Name="Buscar pessoas" />
        <ListBox x:Name="Lista" Grid.Row="4" Style="{StaticResource Lista}" Margin="0,6,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Marcado}" Margin="0" Checked="Marcar_Changed" Unchecked="Marcar_Changed">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="{Binding Pessoa.Nome}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Pessoa.Detalhe}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <TextBlock x:Name="TxtErro" Foreground="{DynamicResource BadText}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnContorno}" Content="Cancelar" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource BtnPrimario}" Content="Criar grupo" IsDefault="True" Click="Criar_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
