<Window x:Class="Softphone.App.EntradaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Softphone.App"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="18,16">
        <TextBlock x:Name="TxtPergunta" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
        <TextBox x:Name="Caixa" Margin="0,8,0,0" FontSize="14" Padding="6,5" TextChanged="Caixa_TextChanged" PreviewKeyDown="Caixa_PreviewKeyDown"
                 AutomationProperties.Name="Nome, ramal ou número" />
        <!-- 1.1.3: sugestões do diretório da empresa (quem tem ramal) e dos contatos, filtradas enquanto digita -->
        <ListBox x:Name="Sugestoes" Style="{StaticResource Lista}" Height="230" Margin="0,6,0,0"
                 MouseDoubleClick="Sugestoes_MouseDoubleClick" AutomationProperties.Name="Sugestões">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" app:Pincel.Recurso="{Binding Cor}"
                                 Visibility="{Binding TemPresenca, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detalhe}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,2,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Numero}" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding Estado}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="TxtDica" Text="Digite o nome, o ramal ou um número externo. O estado (livre, ocupado, offline) é o do Softphone da pessoa; número externo e contato ficam como estado desconhecido." Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource BtnContorno}" Content="Cancelar" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="BtnOk" Style="{StaticResource BtnPrimario}" Content="OK" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
