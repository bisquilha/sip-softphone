<Window x:Class="Softphone.App.EntrarHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entrar no chat" Width="360" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="18,12,18,16">
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                   Text="O login automático pelo Windows não funcionou neste computador. Entre uma vez com o seu usuário e senha de rede (os mesmos do Windows). A senha não fica salva." />
        <TextBlock Style="{StaticResource Rotulo}" Text="Usuário de rede" />
        <TextBox x:Name="CaixaUsuario" AutomationProperties.Name="Usuário de rede" />
        <TextBlock Style="{StaticResource Rotulo}" Text="Senha" />
        <PasswordBox x:Name="CaixaSenha" AutomationProperties.Name="Senha de rede" />
        <TextBlock x:Name="TxtErro" Foreground="{DynamicResource BadText}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource BtnContorno}" Content="Agora não" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="BtnEntrar" Style="{StaticResource BtnPrimario}" Content="Entrar" IsDefault="True" Click="Entrar_Click" />
        </StackPanel>
    </StackPanel>
</Window>
