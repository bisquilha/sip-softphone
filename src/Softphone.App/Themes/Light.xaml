<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema claro. As mesmas chaves existem em Dark.xaml; o app troca conforme o tema do Windows. -->
    <SolidColorBrush x:Key="BgWindow" Color="#F2F5F3" />
    <SolidColorBrush x:Key="BgSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgSurfaceAlt" Color="#E7EEEB" />
    <SolidColorBrush x:Key="BgHover" Color="#E4EFEB" />
    <SolidColorBrush x:Key="BgPressed" Color="#D5E5DF" />
    <SolidColorBrush x:Key="BorderSubtle" Color="#CFDAD5" />
    <SolidColorBrush x:Key="BorderStrong" Color="#62756E" />

    <SolidColorBrush x:Key="TextPrimary" Color="#14241F" />
    <SolidColorBrush x:Key="TextSecondary" Color="#43544D" />
    <SolidColorBrush x:Key="TextMuted" Color="#566660" />

    <SolidColorBrush x:Key="Accent" Color="#00746B" />
    <SolidColorBrush x:Key="AccentHover" Color="#005F57" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentText" Color="#00665E" />
    <SolidColorBrush x:Key="AccentSoft" Color="#D8EEE9" />

    <SolidColorBrush x:Key="CallGreen" Color="#0A7A3D" />
    <SolidColorBrush x:Key="CallGreenHover" Color="#08662F" />
    <SolidColorBrush x:Key="CallRed" Color="#C42B1C" />
    <SolidColorBrush x:Key="CallRedHover" Color="#A32317" />
    <SolidColorBrush x:Key="OnCall" Color="#FFFFFF" />

    <SolidColorBrush x:Key="OkText" Color="#0A6A35" />
    <SolidColorBrush x:Key="BadText" Color="#B3261E" />
    <SolidColorBrush x:Key="WarnText" Color="#7A4B00" />
    <SolidColorBrush x:Key="WarnBg" Color="#FFF4E0" />
    <SolidColorBrush x:Key="WarnBorder" Color="#E0A94A" />

    <SolidColorBrush x:Key="DotOk" Color="#019645" />
    <SolidColorBrush x:Key="DotBad" Color="#E5484D" />
    <SolidColorBrush x:Key="DotWait" Color="#F5A524" />
    <SolidColorBrush x:Key="DotOff" Color="#9AA8A2" />

    <SolidColorBrush x:Key="HeaderBg" Color="#00514A" />
    <SolidColorBrush x:Key="HeaderText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderSubtext" Color="#CFE8E2" />
    <SolidColorBrush x:Key="HeaderButtonHover" Color="#0A6A61" />
    <SolidColorBrush x:Key="HeaderButtonOn" Color="#C42B1C" />

    <SolidColorBrush x:Key="CallCardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CallCardBorder" Color="#9FCFC6" />
    <SolidColorBrush x:Key="FocusRing" Color="#00665E" />
    <LinearGradientBrush x:Key="DialerBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D5E8E0" Offset="0" />
        <GradientStop Color="#EAF1EE" Offset="0.55" />
        <GradientStop Color="#F3F6F4" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DialerText" Color="#14211D" />
    <SolidColorBrush x:Key="DialerMuted" Color="#50625B" />
</ResourceDictionary>
