<Window x:Class="Softphone.App.RamaisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Softphone.App"
        Title="Painel de ramais - Softphone" Width="900" Height="640" MinWidth="520" MinHeight="380"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13" Icon="Assets/softphone.ico" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="Bloco" DataType="{x:Type app:PessoaVM}">
            <Border x:Name="Cartao" Width="196" Height="72" Margin="4" CornerRadius="8" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" AllowDrop="True" Drop="Bloco_Drop" DragOver="Bloco_DragOver"
                    MouseLeftButtonDown="Bloco_MouseDown" ToolTip="{Binding TextoStatus}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="8,0,0,8" app:Pincel.Recurso="{Binding CorPresenca}" />
                    <Grid Grid.Column="1" Margin="8,5,6,5">
                        <StackPanel>
                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Ramal, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                                <Run Text=" " /><Run Text="{Binding Setor, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding TextoStatus}" Foreground="{DynamicResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- ações (aparecem ao passar o mouse) -->
                        <StackPanel x:Name="Acoes" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"
                                    Background="{DynamicResource BgSurface}">
                            <Button Style="{StaticResource BtnIcone}" Content="&#xE8AB;" ToolTip="Transferir a ligação direto para esta pessoa" Click="Transferir_Click"
                                    Visibility="{Binding DataContext.TemChamada, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource BtnIcone}" Content="&#xE8D4;" ToolTip="Falar antes com a pessoa (transferência assistida)" Click="Consultar_Click"
                                    Visibility="{Binding DataContext.TemChamada, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource BtnIcone}" Content="&#xE717;" ToolTip="Ligar" Click="Ligar_Click" Foreground="{DynamicResource CallGreen}"
                                    Visibility="{Binding DataContext.SemChamada, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource BtnIcone}" Content="&#xE8BD;" ToolTip="Conversar" Click="Conversar_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Cartao" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Acoes" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Cartao" Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- filtros -->
        <Border Background="{DynamicResource HeaderBg}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="CaixaBusca" TextChanged="Filtro_Changed" AutomationProperties.Name="Buscar" />
                    <TextBlock x:Name="DicaBusca" Text="Buscar nome, setor ou ramal" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <ComboBox x:Name="CaixaUnidade" Grid.Column="1" Width="180" Margin="10,0,0,0" SelectionChanged="Filtro_Changed" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkSoRamal" Content="Só com ramal" IsChecked="True" Foreground="{DynamicResource HeaderText}" Checked="Filtro_Changed" Unchecked="Filtro_Changed" Margin="0,0,12,0" />
                    <CheckBox x:Name="ChkSoOnline" Content="Só com Softphone aberto" Foreground="{DynamicResource HeaderText}" Checked="Filtro_Changed" Unchecked="Filtro_Changed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ligação em andamento: arraste para um ramal para transferir -->
        <Border x:Name="FaixaChamada" Grid.Row="1" Background="{DynamicResource CallCardBg}" BorderBrush="{DynamicResource CallCardBorder}" BorderThickness="0,0,0,1"
                Padding="12,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="ChipChamada" Background="{DynamicResource Accent}" CornerRadius="16" Padding="12,6" Cursor="SizeAll"
                        MouseMove="Chip_MouseMove" ToolTip="Arraste até a pessoa para transferir direto">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE717;" Foreground="{DynamicResource OnAccent}" Margin="0,2,8,0" />
                        <TextBlock x:Name="TxtChamada" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"
                           Text="Arraste a ligação até a pessoa para transferir direto, ou passe o mouse no ramal: transferir (seta) ou falar antes (consultar)." />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8,4">
            <ItemsControl x:Name="Blocos" ItemTemplate="{StaticResource Bloco}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="6,12,0,2" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}">
                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  ·  " Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" />
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="TxtVazio" Grid.Row="2" HorizontalAlignment="Center" Margin="0,60,0,0" Foreground="{DynamicResource TextMuted}" Visibility="Collapsed" TextWrapping="Wrap" />

        <!-- legenda -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="TxtTotal" DockPanel.Dock="Right" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource DotOk}" VerticalAlignment="Center" /><TextBlock Text="Livre" Margin="5,0,14,0" FontSize="12" />
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource DotBad}" VerticalAlignment="Center" /><TextBlock Text="Em ligação / não perturbe" Margin="5,0,14,0" FontSize="12" />
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource DotWait}" VerticalAlignment="Center" /><TextBlock Text="Ausente" Margin="5,0,14,0" FontSize="12" />
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource DotOff}" VerticalAlignment="Center" /><TextBlock Text="Sem Softphone aberto (pode ter telefone de mesa)" Margin="5,0,0,0" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
