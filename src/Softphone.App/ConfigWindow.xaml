<Window x:Class="Softphone.App.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações" Width="560" Height="680" MinWidth="480" MinHeight="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="BoasVindas" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="12,10" Margin="16,12,16,0" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="Bem-vindo ao Softphone." />
                <Run Text="Informe o seu ramal e a senha (os mesmos do MicroSIP). O servidor já vem preenchido pela TI." />
            </TextBlock>
        </Border>

        <TabControl x:Name="Abas" Grid.Row="1" Margin="10,8,10,0">
            <!-- ======================= CONTA ======================= -->
            <TabItem Header="Conta">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Rotulo}" Text="Ramal (usuário) *" />
                                <TextBox x:Name="CaixaUsuario" AutomationProperties.Name="Ramal" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Rotulo}" Text="Senha *" />
                                <PasswordBox x:Name="CaixaSenha" AutomationProperties.Name="Senha" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TxtRamalSugerido" Foreground="{DynamicResource AccentText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock Style="{StaticResource Rotulo}" Text="Nome de exibição" />
                        <TextBox x:Name="CaixaNomeExibicao" AutomationProperties.Name="Nome de exibição" />

                        <TextBlock Style="{StaticResource Secao}" Text="Servidor do telefone (PABX)" />
                        <TextBlock Style="{StaticResource Rotulo}" Text="Servidor SIP *" />
                        <TextBox x:Name="CaixaServidor" AutomationProperties.Name="Servidor SIP" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Rotulo}" Text="Domínio (vazio = servidor)" />
                                <TextBox x:Name="CaixaDominio" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Rotulo}" Text="Login (vazio = ramal)" />
                                <TextBox x:Name="CaixaLogin" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Rotulo}" Text="Proxy SIP (opcional)" />
                        <TextBox x:Name="CaixaProxy" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Rotulo}" Text="Transporte" />
                                <ComboBox x:Name="CaixaTransporte"><ComboBoxItem Content="UDP" /><ComboBoxItem Content="TCP" /></ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Rotulo}" Text="Registro (s)" />
                                <TextBox x:Name="CaixaRegistro" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource Rotulo}" Text="Manter ativo (s)" />
                                <TextBox x:Name="CaixaManterAtivo" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Secao}" Text="Servidor do chat, reuniões e IA" />
                        <TextBlock Style="{StaticResource Rotulo}" Text="Endereço (vem pronto da TI)" />
                        <TextBox x:Name="CaixaHub" AutomationProperties.Name="Endereço do servidor do chat" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= ÁUDIO ======================= -->
            <TabItem Header="Áudio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,12">
                        <TextBlock Style="{StaticResource Rotulo}" Text="Microfone" />
                        <ComboBox x:Name="CaixaMicrofone" SelectionChanged="Microfone_SelectionChanged" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ProgressBar x:Name="NivelMic" Height="8" Minimum="0" Maximum="1" VerticalAlignment="Center" Foreground="{DynamicResource CallGreen}" Background="{DynamicResource BgSurfaceAlt}" BorderThickness="0" />
                            <Button x:Name="BtnTestarMic" Grid.Column="1" Style="{StaticResource BtnContorno}" Content="Testar microfone" Padding="10,4" Margin="10,0,0,0" Click="TestarMicrofone_Click" />
                        </Grid>
                        <TextBlock x:Name="TxtMic" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Ganho do microfone" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                            <Slider x:Name="SliderGanho" Grid.Column="1" Minimum="25" Maximum="400" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged" />
                            <TextBlock x:Name="TxtGanho" Grid.Column="2" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Style="{StaticResource Rotulo}" Text="Alto-falante / headset (conversa)" />
                        <ComboBox x:Name="CaixaAltoFalante" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Volume da conversa" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                            <Slider x:Name="SliderVolumeConversa" Grid.Column="1" Minimum="25" Maximum="300" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged" />
                            <TextBlock x:Name="TxtVolumeConversa" Grid.Column="2" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Style="{StaticResource Secao}" Text="Tratamento da voz" />
                        <CheckBox x:Name="ChkEco" Content="Cancelar o eco (viva-voz, caixinha de som, microfone do notebook)" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Reduzir ruído de fundo" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox x:Name="CaixaRuido" Grid.Column="1">
                                <ComboBoxItem Content="Desligado" Tag="Desligado" />
                                <ComboBoxItem Content="Pouco" Tag="Baixo" />
                                <ComboBoxItem Content="Médio (recomendado)" Tag="Moderado" />
                                <ComboBoxItem Content="Muito (ambiente barulhento)" Tag="Alto" />
                                <ComboBoxItem Content="Máximo" Tag="MuitoAlto" />
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="ChkVolumeAuto" Content="Ajustar sozinho o volume do microfone (quem fala longe ou baixo)" Margin="0,8,0,0" />
                        <TextBlock x:Name="TxtVozInfo" Text="Vale a partir da próxima ligação. Com headset o eco quase não aparece, mas deixar ligado não atrapalha."
                                   Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Style="{StaticResource Secao}" Text="Campainha" />
                        <TextBlock Style="{StaticResource Rotulo}" Text="Onde toca quando alguém liga" />
                        <ComboBox x:Name="CaixaCampainha" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Volume da campainha" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                            <Slider x:Name="SliderVolume" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged" />
                            <TextBlock x:Name="TxtVolume" Grid.Column="2" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Style="{StaticResource Rotulo}" Text="Toque personalizado (arquivo .wav; vazio = toque padrão)" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="CaixaToque" IsReadOnly="True" />
                            <Button Grid.Column="1" Style="{StaticResource BtnContorno}" Content="Escolher..." Padding="10,5" Margin="6,0,0,0" Click="EscolherToque_Click" />
                            <Button Grid.Column="2" Style="{StaticResource BtnContorno}" Content="Padrão" Padding="10,5" Margin="6,0,0,0" Click="LimparToque_Click" />
                            <Button x:Name="BtnTestar" Grid.Column="3" Style="{StaticResource BtnContorno}" Content="Testar" Padding="10,5" Margin="6,0,0,0" Click="TestarCampainha_Click" />
                        </Grid>
                        <!-- 1.3: toque por tipo de chamada -->
                        <TextBlock Style="{StaticResource Rotulo}" Text="Toque por tipo de chamada (escolha e clique em Ouvir)" Margin="0,12,0,0" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Chamada interna" VerticalAlignment="Center" /><ComboBox x:Name="CbToqueInterno" Grid.Column="1" Margin="0,2" AutomationProperties.Name="Toque das chamadas internas" />
                            <Button Grid.Column="2" Style="{StaticResource BtnContorno}" Content="Ouvir" Padding="10,4" Margin="6,2,0,2" Click="OuvirToqueTipo_Click" Tag="interno" />
                            <TextBlock Grid.Row="1" Text="Chamada externa" VerticalAlignment="Center" /><ComboBox x:Name="CbToqueExterno" Grid.Row="1" Grid.Column="1" Margin="0,2" AutomationProperties.Name="Toque das chamadas externas" />
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource BtnContorno}" Content="Ouvir" Padding="10,4" Margin="6,2,0,2" Click="OuvirToqueTipo_Click" Tag="externo" />
                            <TextBlock Grid.Row="2" Text="Fila ou setor" VerticalAlignment="Center" /><ComboBox x:Name="CbToqueFila" Grid.Row="2" Grid.Column="1" Margin="0,2" AutomationProperties.Name="Toque das chamadas de fila ou setor" />
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource BtnContorno}" Content="Ouvir" Padding="10,4" Margin="6,2,0,2" Click="OuvirToqueTipo_Click" Tag="fila" />
                        </Grid>
                        <TextBlock Style="{StaticResource Rotulo}" Text="Números de fila ou setor (separados por vírgula)" Margin="0,8,0,0" />
                        <TextBox x:Name="CaixaNumerosFila" AutomationProperties.Name="Números de fila ou setor" />
                        <TextBlock Text="Interna = ramal de até 5 dígitos. O que não for interno nem estiver na lista é externo." Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= CHAMADAS ======================= -->
            <!-- 1.2.7 (11/11/2026, pedido do Ana): listas para escolher o toque da chamada e o som das teclas; as linhas são montadas em ConfigWindow.xaml.cs -->
            <TabItem Header="Sons">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,12">
                        <TextBlock Style="{StaticResource Secao}" Text="Toque de chamada recebida" />
                        <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Escolha o som que toca quando alguém liga. Ao escolher, ele toca para você ouvir. Volume e saída: aba Áudio." />
                        <StackPanel x:Name="ListaToquePadrao" />
                        <Button Style="{StaticResource BtnContorno}" Content="Usar um arquivo meu (.wav)..." Padding="10,5" Margin="0,8,0,0" HorizontalAlignment="Left" Click="ArquivoDeToque_Click" />
                        <TextBlock x:Name="TxtArquivoToque" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Chamada interna, externa e de fila ainda podem ter um toque próprio, na aba Chamadas." />

                        <TextBlock Style="{StaticResource Secao}" Text="Som das teclas do discador" Margin="0,22,0,0" />
                        <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Escolha o som ao tocar nas teclas numéricas. Sai no alto-falante da conversa (aba Áudio)." />
                        <StackPanel x:Name="ListaSomTecla" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Chamadas">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,12">
                        <TextBlock Style="{StaticResource Secao}" Text="Gravação" Margin="0,8,0,2" />
                        <CheckBox x:Name="ChkGravarAuto" Content="Gravar minhas ligações automaticamente" />
                        <TextBlock Text="Toda ligação atendida (feita ou recebida) começa a gravar sozinha, com o aviso de gravação. O botão Gravar da ligação continua parando ou recomeçando a gravação."
                                   FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="22,2,0,0" />
                        <CheckBox x:Name="ChkTranscreverAuto" Content="Transcrever e resumir as gravações automaticamente" Margin="0,10,0,0" />
                        <TextBlock Text="Desligado: a gravação fica só com o áudio. Para transcrever uma delas, abra Gravações e clique em Transcrever."
                                   FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="22,2,0,0" />

                        <TextBlock Style="{StaticResource Secao}" Text="Atendimento automático" />
                        <CheckBox x:Name="ChkAtenderAuto" Content="Atender sozinho chamadas recebidas" />
                        <StackPanel Orientation="Horizontal" Margin="22,6,0,0">
                            <TextBlock Text="depois de" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                            <TextBox x:Name="CaixaAtenderSeg" Width="50" Margin="6,0" />
                            <TextBlock Text="segundos" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <CheckBox x:Name="ChkAtenderSoInternos" Content="Só ramais internos (até 5 dígitos)" Margin="22,6,0,0" />

                        <TextBlock Style="{StaticResource Secao}" Text="Encaminhar chamadas" />
                        <TextBlock Text="Deixe em branco para não encaminhar. Depende do PABX aceitar o encaminhamento (302)." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Rotulo}" Text="Sempre para" />
                        <TextBox x:Name="CaixaEncSempre" />
                        <TextBlock Style="{StaticResource Rotulo}" Text="Quando eu estiver em outra chamada, para" />
                        <TextBox x:Name="CaixaEncOcupado" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Rotulo}" Text="Se eu não atender, para" />
                                <TextBox x:Name="CaixaEncNaoAtende" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Rotulo}" Text="depois de (s)" />
                                <TextBox x:Name="CaixaEncSeg" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Secao}" Text="Codecs de áudio (ordem de preferência)" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ListBox x:Name="ListaCodecs" Style="{StaticResource Lista}" Height="96" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Ativo}" Content="{Binding Descricao}" Margin="0" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Button Style="{StaticResource BtnIcone}" Content="&#xE70E;" ToolTip="Subir" Click="CodecSubir_Click" />
                                <Button Style="{StaticResource BtnIcone}" Content="&#xE70D;" ToolTip="Descer" Click="CodecDescer_Click" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Secao}" Text="Números bloqueados" />
                        <TextBlock Text="Um por linha. Chamadas desses números são recusadas automaticamente." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBox x:Name="CaixaBloqueados" AcceptsReturn="True" Height="70" VerticalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= CHAT E VÍDEO ======================= -->
            <TabItem Header="Chat e vídeo">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,12">
                        <TextBlock Style="{StaticResource Secao}" Text="Avisos" Margin="0,8,0,2" />
                        <CheckBox x:Name="ChkNotificar" Content="Avisar mensagens novas (balão no canto da tela)" />
                        <CheckBox x:Name="ChkSomMensagem" Content="Tocar um som curto ao chegar mensagem" />
                        <CheckBox x:Name="ChkAvisoTopo" Content="Mostrar o aviso de chamada no canto de CIMA da tela (padrão: embaixo)" />
                        <TextBlock Style="{StaticResource Secao}" Text="Presença" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Ficar &quot;Ausente&quot; depois de" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                            <TextBox x:Name="CaixaAusenteMin" Width="50" Margin="6,0" />
                            <TextBlock Text="minutos sem mexer no PC (0 = nunca)" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Secao}" Text="Reuniões" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Text="As reuniões usam a câmera e o microfone escolhidos no próprio Windows (Configurações &gt; Privacidade &gt; Câmera). Dentro da reunião dá para trocar pelo botão ⚙ do Jitsi." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= REDE ======================= -->
            <TabItem Header="Rede">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,12">
                        <TextBlock Style="{StaticResource Rotulo}" Text="Porta SIP local (0 = escolher uma livre)" />
                        <TextBox x:Name="CaixaPortaSip" Width="120" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Rotulo}" Text="Faixa de portas RTP do áudio (0 a 0 = qualquer)" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="CaixaRtpIni" Width="90" />
                            <TextBlock Text="até" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextSecondary}" />
                            <TextBox x:Name="CaixaRtpFim" Width="90" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Secao}" Text="Diagnóstico" />
                        <CheckBox x:Name="ChkLogSip" Content="Gravar o tráfego SIP no log" />
                        <Button Style="{StaticResource BtnContorno}" Content="Abrir pasta de logs" HorizontalAlignment="Left" Margin="0,8,0,0" Click="AbrirLogs_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= GERAL ======================= -->
            <TabItem Header="Geral">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,12">
                        <TextBlock Style="{StaticResource Rotulo}" Text="Tema" />
                        <ComboBox x:Name="CaixaTema" Width="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Seguir o Windows" Tag="Sistema" />
                            <ComboBoxItem Content="Claro" Tag="Claro" />
                            <ComboBoxItem Content="Escuro" Tag="Escuro" />
                            <ComboBoxItem Content="Oliva (verde-oliva para preto)" Tag="Oliva" />
                            <ComboBoxItem Content="Oceano (azul para preto)" Tag="Oceano" />
                            <ComboBoxItem Content="Grafite (cinza para preto)" Tag="Grafite" />
                            <ComboBoxItem Content="Vinho (vinho para preto)" Tag="Vinho" />
                            <ComboBoxItem Content="Roxo (roxo para preto)" Tag="Roxo" />
                            <ComboBoxItem Content="Âmbar (laranja para preto)" Tag="Ambar" />
                            <ComboBoxItem Content="Cor personalizada (tabela de cores)" Tag="Personalizado" />
                        </ComboBox>
                        <CheckBox x:Name="ChkIniciar" Content="Iniciar com o Windows (fica na bandeja)" Margin="0,14,0,0" />
                        <CheckBox x:Name="ChkAtalhos" Content="Atalhos em qualquer janela (você pode trocar cada um abaixo)" />
                        <StackPanel x:Name="PainelAtalhos" Margin="22,6,0,0" />
                        <TextBlock Text="Clique no campo e aperte a combinação (precisa de Ctrl ou Alt). Se outro programa já usa a combinação, o Softphone avisa no log." Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="22,2,0,0" />
                        <TextBlock Style="{StaticResource Rotulo}" Text="Ramais favoritos (para os atalhos &quot;Ligar para o favorito&quot;)" Margin="22,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="22,2,0,0">
                            <TextBox x:Name="CaixaFav1" Width="90" Margin="0,0,6,0" AutomationProperties.Name="Favorito 1" />
                            <TextBox x:Name="CaixaFav2" Width="90" Margin="0,0,6,0" AutomationProperties.Name="Favorito 2" />
                            <TextBox x:Name="CaixaFav3" Width="90" AutomationProperties.Name="Favorito 3" />
                            <Button Style="{StaticResource BtnContorno}" Content="Restaurar atalhos padrão" Padding="10,4" Margin="12,0,0,0" Click="RestaurarAtalhos_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Secao}" Text="Clicar para ligar" />
                        <CheckBox x:Name="ChkLinksTel" Content="Abrir no Softphone os links de telefone (tel:, sip:, callto:) do navegador, e-mail e sistemas" />
                        <CheckBox x:Name="ChkLinkDiscaDireto" Content="Ligar na hora (desmarcado: só põe o número no discador para conferir)" Margin="22,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Prefixo para números externos" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                            <TextBox x:Name="CaixaPrefixoExterno" Width="60" Margin="8,0" ToolTip="Ex.: 0 se o PABX pede 0 para sair. Vazio = disca como está." />
                            <TextBlock Text="(vazio = disca como está)" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                        </StackPanel>
                        <TextBlock x:Name="TxtLinksTel" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Na primeira vez que você clicar num link de telefone, o Windows pergunta com qual programa abrir: escolha Softphone e marque 'Sempre'." />
                        <TextBlock Style="{StaticResource Secao}" Text="Configurações" />
                        <WrapPanel>
                            <Button Style="{StaticResource BtnContorno}" Content="Exportar..." Padding="10,5" Margin="0,0,8,8" Click="Exportar_Click" ToolTip="Salva estas configurações num arquivo (sem a senha)" />
                            <Button Style="{StaticResource BtnContorno}" Content="Importar..." Padding="10,5" Margin="0,0,8,8" Click="Importar_Click" />
                            <Button Style="{StaticResource BtnContorno}" Content="Restaurar padrões" Padding="10,5" Margin="0,0,8,8" Click="Restaurar_Click" ToolTip="Volta áudio, chamadas e aparência ao padrão (mantém a conta)" />
                        </WrapPanel>
                        <TextBlock x:Name="TxtVersao" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <TextBlock x:Name="TxtErro" Foreground="{DynamicResource BadText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,180,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnContorno}" Content="Cancelar" IsCancel="True" Margin="0,0,8,0" />
                    <Button Style="{StaticResource BtnPrimario}" Content="Salvar" IsDefault="True" Click="Salvar_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
