<Window x:Class="Softphone.App.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Softphone.App"
        Width="440" Height="600" MinWidth="340" MinHeight="380"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13" Icon="Assets/softphone.ico" UseLayoutRounding="True"
        AllowDrop="True" Drop="Janela_Drop" DragOver="Janela_DragOver">
    <Window.Resources>
        <DataTemplate x:Key="Balao" DataType="{x:Type app:MensagemVM}">
            <Grid Margin="10,3">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Minha}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border CornerRadius="12" Padding="10,6,10,5" MaxWidth="320" ContextMenuOpening="Balao_ContextMenuOpening">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Responder" Tag="responder" Click="MenuMensagem_Click" />
                            <MenuItem Header="Copiar texto" Tag="copiar" Click="MenuMensagem_Click" />
                            <MenuItem Header="Editar" Tag="editar" Click="MenuMensagem_Click" />
                            <Separator />
                            <MenuItem Header="Apagar para todos" Tag="apagar" Click="MenuMensagem_Click" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Minha}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MencionaMe}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Destacada}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarnBorder}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding AutorNome}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" Margin="0,0,0,2"
                                   Visibility="{Binding MostrarAutor, Converter={StaticResource BoolToVis}}" />
                        <!-- citação: clique leva até a mensagem original -->
                        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0" Background="{DynamicResource BgSurfaceAlt}" CornerRadius="2"
                                Padding="7,3" Margin="0,1,0,4" Cursor="Hand" MouseLeftButtonUp="Citacao_Click" ToolTip="Ir para a mensagem citada"
                                Visibility="{Binding TemCitacao, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding CitacaoAutor}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                                <TextBlock Text="{Binding CitacaoTrecho}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <TextBox Text="{Binding Texto, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                                 FontSize="13.5" Visibility="{Binding TemTexto, Converter={StaticResource BoolToVis}}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Apagada}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <StackPanel Visibility="{Binding EhReuniao, Converter={StaticResource BoolToVis}}" Margin="0,2,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE714;" Foreground="{DynamicResource AccentText}" FontSize="16" Margin="0,1,8,0" />
                                <TextBlock Text="{Binding TituloReuniao}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="240" />
                            </StackPanel>
                            <Button Style="{StaticResource BtnPrimario}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,6" Click="EntrarReuniao_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE714;" Margin="0,2,6,0" />
                                    <TextBlock Text="Entrar na reunião" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource BtnContorno}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,5" Click="Arquivo_Click"
                                Visibility="{Binding TemArquivo, Converter={StaticResource BoolToVis}}" ToolTip="Abrir o arquivo">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE8A5;" Margin="0,2,8,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding ArquivoNome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                                    <TextBlock Text="{Binding ArquivoTamanho}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Hora}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding Marca}" FontSize="10.5" Margin="4,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Lida}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- cabeçalho -->
        <Border Background="{DynamicResource HeaderBg}" Padding="12,9,8,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="36" Height="36">
                    <Border CornerRadius="18" Background="{DynamicResource AccentSoft}">
                        <TextBlock x:Name="TxtIniciais" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Ellipse x:Name="PontoPresenca" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{DynamicResource HeaderBg}" StrokeThickness="2" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitulo" Foreground="{DynamicResource HeaderText}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TxtSub" Foreground="{DynamicResource HeaderSubtext}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnVideo" Style="{StaticResource BtnHeader}" Content="&#xE714;" ToolTip="Chamada de vídeo (toca para quem está online)" Click="Video_Click" />
                    <Button x:Name="BtnLigar" Style="{StaticResource BtnHeader}" Content="&#xE717;" ToolTip="Ligar" Click="Ligar_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- mensagens -->
        <ScrollViewer x:Name="Rolagem" Grid.Row="1" VerticalScrollBarVisibility="Auto" ScrollChanged="Rolagem_ScrollChanged">
            <StackPanel Margin="0,6,0,6">
                <Button x:Name="BtnAnteriores" Style="{StaticResource BtnContorno}" Content="Carregar mensagens anteriores" HorizontalAlignment="Center"
                        Padding="10,4" FontSize="12" Margin="0,4,0,6" Click="Anteriores_Click" Visibility="Collapsed" />
                <TextBlock x:Name="TxtVazio" Text="Nenhuma mensagem ainda. Diga oi! 👋" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed" />
                <ItemsControl x:Name="ListaMensagens" ItemTemplate="{StaticResource Balao}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="TxtDigitando" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" FontStyle="Italic" Margin="14,0,0,2" Visibility="Collapsed" />
            <Border x:Name="BarraResposta" BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0" Background="{DynamicResource BgSurfaceAlt}"
                    Margin="8,2,8,0" Padding="8,4,4,4" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TxtBarraTitulo" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                        <TextBlock x:Name="TxtBarraTrecho" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource BtnIcone}" Content="&#xE711;" ToolTip="Cancelar (Esc)" Click="CancelarBarra_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
        <Popup x:Name="PopupMencao" Grid.Row="3" Placement="Top" PlacementTarget="{Binding ElementName=Caixa}" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="2" MinWidth="220">
                <ListBox x:Name="ListaMencao" Style="{StaticResource Lista}" MaxHeight="200" MouseLeftButtonUp="ListaMencao_Click">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type app:PessoaVM}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" app:Pincel.Recurso="{Binding CorPresenca}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Setor}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="6,1,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>

        <!-- digitação -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource BtnIcone}" Content="&#xE723;" ToolTip="Enviar arquivo (ou arraste para a janela)" Click="Anexar_Click" />
                </StackPanel>
                <TextBox x:Name="Caixa" Grid.Column="1" Margin="4,0" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="Caixa_PreviewKeyDown" TextChanged="Caixa_TextChanged" AutomationProperties.Name="Mensagem" />
                <TextBlock Grid.Column="1" x:Name="DicaCaixa" Text="Escreva uma mensagem (Enter envia, Shift+Enter quebra a linha)" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False" FontSize="12" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" x:Name="BtnEnviar" Style="{StaticResource BtnPrimario}" Padding="10,7" Click="Enviar_Click" VerticalAlignment="Bottom" ToolTip="Enviar (Enter)">
                    <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE724;" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
