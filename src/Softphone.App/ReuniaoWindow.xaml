<Window x:Class="Softphone.App.ReuniaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Reunião - Softphone" Width="1100" Height="720" MinWidth="640" MinHeight="420"
        Background="#1C1C1C" FontFamily="Segoe UI" FontSize="13" Icon="Assets/softphone.ico" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- botões da barra da reunião (fundo escuro, como o Jitsi) -->
        <Style x:Key="BtnBarra" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="BorderBrush" Value="#4A4A4A" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="#3C3C3C" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Fundo" Property="BorderBrush" Value="#8CB6FA" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 1.1.3: chamar mais gente com a reunião aberta (como no Teams), sem mandar link -->
        <DockPanel Background="#232323" LastChildFill="False">
            <TextBlock x:Name="TxtTitulo" DockPanel.Dock="Left" Foreground="#E6E6E6" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="14,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,6,10,6">
                <Button Style="{StaticResource BtnBarra}" Click="Adicionar_Click" ToolTip="Escolha quem chamar: toca no Softphone de quem está online">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE8FA;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Adicionar pessoas" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnBarra}" Click="CopiarLink_Click" ToolTip="Copia o link da reunião (abre no navegador de qualquer PC da empresa)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE8C8;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Copiar link" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
        <wv2:WebView2 x:Name="Navegador" Grid.Row="1" />
        <StackPanel x:Name="Carregando" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE714;" FontSize="40" Foreground="#8CB6FA" HorizontalAlignment="Center" />
            <TextBlock x:Name="TxtCarregando" Text="Entrando na reunião..." Foreground="White" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />
        </StackPanel>
    </Grid>
</Window>
