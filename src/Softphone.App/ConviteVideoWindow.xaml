<Window x:Class="Softphone.App.ConviteVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chamada de vídeo" Width="340" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource CallCardBorder}" BorderThickness="1" CornerRadius="12" Margin="10" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE714;" Foreground="{DynamicResource AccentText}" Margin="0,2,6,0" />
                <TextBlock x:Name="TxtTipo" Text="Chamada de vídeo" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
            </StackPanel>
            <TextBlock x:Name="TxtNome" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TxtTitulo" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <UniformGrid Columns="2" Margin="0,12,0,0">
                <Button Style="{StaticResource BtnVerde}" Margin="0,0,4,0" Padding="0,9" Click="Atender_Click" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE714;" Margin="0,1,6,0" />
                        <TextBlock Text="Atender" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnVermelho}" Margin="4,0,0,0" Padding="0,9" Click="Recusar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icones}" Text="&#xE778;" Margin="0,1,6,0" />
                        <TextBlock Text="Recusar" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
