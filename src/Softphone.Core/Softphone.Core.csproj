<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.*" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <!-- Cancelamento de eco / redução de ruído: só a biblioteca nativa do WebRTC APM (webrtc-apm.dll, BSD).
         A ligação com ela é nossa (ProcessadorVoz.cs); o wrapper e o motor SoundFlow ficam de fora. -->
    <PackageReference Include="SoundFlow.Extensions.WebRtc.Apm" Version="1.4.2" ExcludeAssets="compile;runtime;build;buildTransitive" />
    <PackageReference Include="SoundFlow" Version="1.4.2" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Softphone.Contratos\Softphone.Contratos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Softphone.PabxTeste" />
  </ItemGroup>

</Project>
