# Copie para hub.env (chmod 600) e troque a senha. NÃO versionar o hub.env.
# Leitura do AD (diretório + login com senha de reserva), por LDAPS:
Hub__Ldap__Servidor=DC01.corp.example.com
Hub__Ldap__Porta=636
Hub__Ldap__Ssl=true
Hub__Ldap__BaseDn=DC=Homelab,DC=local
Hub__Ldap__Dominio=CORP
Hub__Ldap__Usuario=CORP\svc-softphone
Hub__Ldap__Senha=TROCAR
# CAs confiáveis para o LDAPS (inclui a CORP-ROOT-CA)
LDAPTLS_CACERT=/etc/ssl/certs/ca-certificates.crt
# Login automático pelo Windows (Kerberos)
KRB5_KTNAME=/etc/softphone/softphone.keytab
# Gravação de ligações + IA (decisão de 04/11: transcrição LOCAL no whisper; resumo/sugestões pela API da Anthropic,
# que recebe só o TEXTO). Gravações, transcrições e resumos são apagados depois de RetencaoDias.
Hub__Ia__WhisperUrl=http://whisper:9000
Hub__Ia__RetencaoDias=90
# Chave da API da Anthropic (console.anthropic.com > API Keys). Vazio = só transcrição, sem resumo nem "Sugerir resposta".
Hub__Ia__AnthropicChave=
# Base de conhecimento da empresa para a IA: arquivos .md/.txt em /opt/softphone/dados/conhecimento
# TI que pode ler /api/admin/ramais (script Gravar-Ramais-AD.ps1 grava no AD os ramais que o Softphone aprendeu):
Hub__Admins__0=ana.souza
# Nunca ligar em produção:
Hub__Teste=false
